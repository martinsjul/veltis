# Copie este arquivo para backend/.env e preencha com a conexão do banco.
# Nunca versione o arquivo .env real.
#
# Supabase: Project Settings > Database > Connection string (URI).
# Use a conexão direta ou o "Session pooler" (porta 5432).
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST:5432/postgres?sslmode=require

# Opcional: banco DESCARTÁVEL para os testes de integração (nunca o Supabase).
# VELTIS_TESTE_DATABASE_URL=postgresql+psycopg://postgres:senha@localhost:5432/veltis_teste
