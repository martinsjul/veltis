# Credenciais e ambiente (nunca versionar)
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example
*.key
secrets/
# Chaves .pem são ignoradas, exceto o certificado público do INEP usado nos downloads
*.pem
!backend/certs/*.pem
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# IDE / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Dados brutos e processados: reproduzíveis, não versionados
backend/data/raw/**
backend/data/processed/**
!backend/data/raw/**/
!backend/data/raw/**/.gitkeep
!backend/data/processed/.gitkeep

# Logs / temporários
*.log
*.tmp

# Arquivos temporários do Office
~$*.docx
~$*.xlsx
~$*.pptx
*.bak

# Frontend
node_modules/
dist/
.vite/
